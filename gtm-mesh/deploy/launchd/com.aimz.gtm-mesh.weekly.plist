<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.aimz.gtm-mesh.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>__MESH_HOME__/deploy/run.sh</string>
    <string>weekly</string>
  </array>
  <!-- Mondays 6:37am local time: brief, leads, drafts and content are ready by the start of the day. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>37</integer>
  </dict>
  <key>StandardOutPath</key><string>__MESH_HOME__/logs/launchd-weekly.out</string>
  <key>StandardErrorPath</key><string>__MESH_HOME__/logs/launchd-weekly.err</string>
</dict>
</plist>
